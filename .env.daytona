# Daytona Deployment Configuration
# Copy this to .env and fill in your values

# Required: Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Optional: Last.fm API Key (for enhanced recommendations)
LASTFM_API_KEY=your_lastfm_key_here

# Optional: AUDD API Token (for audio recognition)
AUDD_API_TOKEN=your_audd_token_here

# Optional: Telegram Proxy (if needed)
TELEGRAM_PROXY=

# Prefetch Configuration
ENABLE_PREFETCH=true
PREFETCH_MODE=artist

# Server Configuration
PORT=8080
